<Window x:Class="PL.MainManagementScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Main Management Screen"
        Width="900" Height="600"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
           ShadowDepth="1" 
           Direction="315" 
           Color="#DDDDDD" 
           Opacity="0.5" 
           BlurRadius="10"/>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Button -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E1F5FE"/>
                    <Setter Property="BorderBrush" Value="#81D4FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="MainActionButton" TargetType="Button">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E1F5FE"/>
                    <Setter Property="BorderBrush" Value="#81D4FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" 
                           RenderingBias="Quality" ShadowDepth="2"
                           Color="#20000000"/>
        </Border.Effect>
        <Border Background="#F9F9F9" CornerRadius="12" Margin="15" Effect="{StaticResource DropShadowEffect}">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="Main Management Screen" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- System Clock and Configuration -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- System Clock -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <Label Content="System Clock" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentTime}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#374151" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,5,0,15"/>
                            <UniformGrid Rows="2" Columns="3">
                                <Button Content="Add Minute" Click="btnAddOneMinute_Click" Margin="3"/>
                                <Button Content="Add Hour" Click="btnAddOneHour_Click" Margin="3"/>
                                <Button Content="Add Day" Click="btnAddOneDay_Click" Margin="3"/>
                                <Button Content="Add Month" Click="btnAddOneMonth_Click" Margin="3"/>
                                <Button Content="Add Year" Click="btnAddOneYear_Click" Margin="3"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Configuration -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="10,0,0,0">
                        <StackPanel>
                            <Label Content="Configuration" FontSize="16" FontWeight="Bold"/>
                            <Label Content="Maximum Time for Call:" />
                            <TextBox Text="{Binding MaxTimeSpanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,10"/>
                            <Button Content="Update" 
                                    Click="btnUpdateMaxYearRange_Click"
                                    HorizontalAlignment="Right"
                                    Width="90" Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main Action Buttons -->
                <Border Grid.Row="2" Background="#F0F4F8" CornerRadius="12" BorderBrush="#D1D5DB" BorderThickness="1" Padding="15">
                    <UniformGrid Rows="1" Columns="4">
                        <Button Content="Volunteer Management" 
                                Style="{StaticResource MainActionButton}"
                                  Click="VolunteerManagementButton_Click"/>
                        <Button Content="Call Management" 
                                Style="{StaticResource MainActionButton}"
                                Click="CallManagementButton_Click"/>
                        <Button Content="Initialize Database" 
                                Style="{StaticResource MainActionButton}"
                                Click="InitializeDB_Click"/>
                        <Button Content="Reset Database" 
                                Style="{StaticResource MainActionButton}"
                                Click="ResetDB_Click"/>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>