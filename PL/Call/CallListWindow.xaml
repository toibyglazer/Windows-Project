<Window x:Class="PL.Call.CallListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL.Call"
        Title="Call List"
        Width="921.6"
        Height="614.4"
        Background="#F9F9F9"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <local:CallStatusCollection x:Key="CallStatusCollection" />
        <local:CallTypesCollection x:Key="CallTypeCollection" />
        <local:RemainingTimeConverter x:Key="RemainingTimeConverter" />
        <local:CompletionTimeConverter x:Key="CompletionTimeConverter" />

        <DropShadowEffect x:Key="DropShadowEffect" 
                          ShadowDepth="0.855" 
                          Direction="315" 
                          Color="#DDDDDD" 
                          Opacity="0.5" 
                          BlurRadius="8.55"/>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="17.1" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                 Grid.ColumnSpan="2" 
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0" />
                <Path x:Name="Arrow"
               Grid.Column="1"     
               Fill="#374151"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Data="M0,0 L0,1.71 L3.42,5.13 L6.84,1.71 L6.84,0 L3.42,3.42 z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Arrow" Property="Fill" Value="#2563EB"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


        <!-- Style for ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34.2"/>
            <Setter Property="Margin" Value="0,4.275,0,12.825"/>
            <Setter Property="Padding" Value="8.55,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="6.84" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="0.855">
                            <Grid>
                                <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Template="{StaticResource ComboBoxToggleButton}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="8.55,0,25.65,0"
                                                  VerticalAlignment="Center"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       Placement="Bottom"
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Background="White" 
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border CornerRadius="6.84" 
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0.855">
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="34.2"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6.84"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.97"/>
            <Setter Property="Margin" Value="0,0,0,4.275"/>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" 
            CornerRadius="12.825" 
            Margin="17.1" 
            Padding="25.65"
            BorderBrush="#E0E0E0"
            BorderThickness="0.855"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Call List" 
                       FontSize="23.94" 
                       FontWeight="Bold" 
                       Margin="0,0,0,17.1"
                       Grid.Row="0"/>

            <!-- Filters in a single white box -->
            <Border Grid.Row="1" Background="White" CornerRadius="8.55" Margin="0,0,0,17.1" Padding="17.1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="71*"/>
                        <ColumnDefinition Width="29*"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter by Status -->
                    <Label Content="Filter Calls By Status:" Grid.Column="0" Grid.Row="0"
                   Style="{StaticResource ModernLabel}" Grid.ColumnSpan="2" Margin="0,0,0,4"/>
                    <ComboBox Grid.Column="0" Grid.Row="1"
                      Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding callStatusCollection}"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedValue="{Binding callStatus, Mode=TwoWay}"
                      Margin="0,4,16,12" Grid.ColumnSpan="2"/>

                    <!-- Filter by Call Type -->
                    <Label Content="Filter Calls By Call Type:" Grid.Column="1" Grid.Row="0"
                   Style="{StaticResource ModernLabel}" Grid.ColumnSpan="2" Margin="116,0,0,4"/>
                    <ComboBox Grid.Row="1"
                      Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding CallTypeCollection}"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedValue="{Binding callType, Mode=TwoWay}"
                      Grid.ColumnSpan="2" Margin="116,4,26,12" Grid.Column="1"/>

                    <!-- Filter by Volunteer Name -->
                    <Label Content="Filter By Last Volunteer:" Grid.Column="0" Grid.Row="2"
                   Style="{StaticResource ModernLabel}" Grid.ColumnSpan="3" Margin="0,8,0,4"/>
                    <TextBox x:Name="VolunteerFilterTextBox" 
                     Grid.Column="0" Grid.Row="3" 
                     Grid.ColumnSpan="3"
                     Height="34.2"
                     Padding="8.55,0"
                     VerticalContentAlignment="Center"
                     Margin="0,4,26,12"
                     TextChanged="VolunteerFilterTextBox_TextChanged"
                     BorderBrush="#E5E7EB"
                     BorderThickness="0.855">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6.84"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="2" x:Name="MainContent">
                <!-- DataGrid -->
                <DataGrid x:Name="CallListView"
                          ItemsSource="{Binding CallList}"
                          SelectedItem="{Binding SelectedCall}"
                          MouseDoubleClick="ListView_MouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0.855"
                          BorderBrush="#E5E7EB"
                          Background="White"
                          RowHeaderWidth="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          Margin="0,0,0,17.1"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E5E7EB"
                          VerticalGridLinesBrush="#E5E7EB">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8.55,12.825"/>
                            <Setter Property="BorderThickness" Value="0,0,0.855,0.855"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8.55,6.84"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" BorderThickness="0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground" Value="#111827"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Id}" Header="Last Assignment Id" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding CallId}" Header="CallId" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding Type}" Header="Type" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding OpeningTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Header="Opening Time" Width="Auto" />

                        <DataGridTextColumn Header="Remaining Time" Width="Auto">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource RemainingTimeConverter}">
                                    <Binding Path="RemainingTime" />
                                    <Binding Path="Status" />
                                    <Binding Path="TotalCompletionTime" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="Completed">
                                            <Setter Property="Foreground" Value="Green" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="Admin Canceled">
                                            <Setter Property="Foreground" Value="#4A5568" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Status}" Value="OpenAtRisk">
                                            <Setter Property="Foreground" Value="Red" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <ColorAnimation 
                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                From="Red" To="White" Duration="0:0:0.6"
                AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="InTreatmentAtRisk">
                                            <Setter Property="Foreground" Value="Red" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <ColorAnimation 
                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                From="Red" To="White" Duration="0:0:0.6"
                AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding LastVolunteer}" Header="Last Volunteer" Width="Auto" />
                        <DataGridTextColumn Header="Total Completion Time" Width="Auto">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource CompletionTimeConverter}">
                                    <Binding Path="TotalCompletionTime" />
                                    <Binding Path="Status" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TotalAssignments}" Header="Total Assignments" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Loading Indicator -->
            <Grid x:Name="LoadingIndicator" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
                <Rectangle Fill="#80000000" />
                <Border Background="White" 
                        CornerRadius="10" 
                        Width="200" 
                        Height="100" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="150" Height="10" Margin="0,0,0,15" />
                        <TextBlock Text="Loading data..." 
                                   Foreground="#374151" 
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Add Call Button -->
            <Button Grid.Row="3"
                    Content="Add Call"
                    Style="{StaticResource ModernButton}"
                    Width="171"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    Click="AddCallButton_Click"/>
        </Grid>
    </Border>
</Window>