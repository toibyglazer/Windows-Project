    <None Remove="Icons\FoodDelivery.png" />
    <None Remove="Icons\FoodPreparation.png" />
    <None Remove="Icons\Icon4.ico" />
    <None Remove="Icons\KitPreparation.png" />
    <None Remove="Icons\MedicalSupport.png" />
    <None Remove="Icons\None.png" />
    <None Remove="Icons\SoldierTransportation.png" />
    <None Remove="Icons\SpecialEventSupport.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BL\BL.csproj" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="ProfileImage\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="ProfileImage\*.jpg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="App.config">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Icons\BaseMaintenance.png">
