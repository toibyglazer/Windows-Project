<Window x:Class="PL.Call.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Call"
        mc:Ignorable="d"
        Title="Call Details" Height="700" Width="1000"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="Transparent"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <local:CallTypesCollection x:Key="callTypesCollection" />
        <local:CallStatusCollection x:Key="callStatusCollection" />

        <!-- ComboBoxToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                    Grid.ColumnSpan="2" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" />
                <Path x:Name="Arrow"
                  Grid.Column="1"     
                  Fill="#374151"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Arrow" Property="Fill" Value="#2563EB"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Grid>
                                <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Template="{StaticResource ComboBoxToggleButton}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="10,0,30,0"
                                                VerticalAlignment="Center"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       Placement="Bottom"
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Background="White" 
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border CornerRadius="8" 
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1">
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Button -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" 
                           RenderingBias="Quality" ShadowDepth="2"
                           Color="#20000000"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Grid Grid.ColumnSpan="2">
                <TextBlock Text="Call Details" 
                         FontSize="28" 
                         FontWeight="Bold" 
                         Foreground="#111827"/>
            </Grid>

            <!-- Left Column -->
            <!-- Left Column -->
            <Border Grid.Row="1" 
        Grid.Column="0" 
        Background="White" 
        CornerRadius="15"
        Margin="0,20,20,0"
        Padding="20">
                <StackPanel>
                    <!-- Call Icon -->
                    <Border Width="180" 
                Height="180" 
                CornerRadius="90" 
                BorderBrush="White" 
                BorderThickness="2"
                Margin="0,0,0,20">


                        <Image x:Name="CallTypeImage" Stretch="Uniform" />
                    </Border>

                    <!-- Call Type -->
                    <Label Content="Call Type"/>
                    <ComboBox x:Name="CallTypeComboBox"
                  ItemsSource="{Binding Source={StaticResource callTypesCollection}}"
                  SelectedValue="{Binding CurrentCall.Type, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                  SelectionChanged="CallTypeComboBox_SelectionChanged"/>

                    <!-- Address -->
                    <Label Content="Address"/>
                    <TextBox Text="{Binding CurrentCall.FullAddress, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                    <!-- Start Time -->
                    <Label Content="Opening Time"/>
                    <TextBox Text="{Binding CurrentCall.OpeningTime, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <!-- Right Column -->
            <Border Grid.Row="1"
                    Grid.Column="1" 
                    Background="White" 
                    CornerRadius="15"
                    Margin="0,20,0,0"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Additional Details" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,20"/>

                    <!-- Deadline -->
                    <Label Content="Deadline"/>
                    <TextBox Text="{Binding CurrentCall.MaxCompletionTime, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                    <!-- Status Type -->
                    <Label Content="Status Type"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource callStatusCollection}}"
                              SelectedValue="{Binding CurrentCall.Status, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>

                    <!-- Description -->
                    <Label Content="Description"/>
                    <TextBox Text="{Binding CurrentCall.Description, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                             Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="DeleteCallButton"
                                Click="DeleteCallButton_Click"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Delete Call"
                                Margin="0,0,10,0">
                            <TextBlock Text="🗑" 
                                       FontSize="20" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="Black"/>
                        </Button>
                        <Button Content="View Assignments" Padding="5" Click="BtnViewAssignments_Click" Width="126"/>

                        <!--<Button Content="Check assignment past list"
                                Click="OnOpenActiveCallClick"
                                Width="180"
                                Margin="0,0,10,0"/>-->

                        <Button Content="{Binding ButtonText}"
                                Click="AddOrUpdateButton_Click"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

