<Window x:Class="PL.VolunteerStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Volunteer Statistics" Height="520" Width="800"
        Icon="pack://application:,,,/PL;component/Icons/Icon4.ico"
        Background="#F9F9F9"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- Style for Stat Number -->
        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- Style for Stat Label -->
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Style for Section Headers -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Simple Card Style -->
        <Style x:Key="SimpleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column - Volunteer Profile -->
        <StackPanel Grid.Column="0" Width="120" Margin="0,0,16,0">
            <!-- Volunteer Avatar -->
            <Border x:Name="ProfileBorder"
                    Width="96" 
                    Height="96" 
                    CornerRadius="48"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <Border.Background>
                    <ImageBrush x:Name="ProfileImageBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Volunteer Info -->
            <TextBlock Text="{Binding VolunteerName}" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="#111827"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding VolunteerRole}" 
                       FontSize="12" 
                       Foreground="#374151"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right Column - Statistics and Charts -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary Stats -->
            <Border Grid.Row="0" Style="{StaticResource SimpleCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Calls -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TotalCalls}" 
                                   Style="{StaticResource StatNumberStyle}" 
                                   Foreground="#3B82F6"/>
                        <TextBlock Text="Total Calls" 
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>

                    <!-- Treated Calls -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding TreatedCalls}" 
                                   Style="{StaticResource StatNumberStyle}" 
                                   Foreground="#10B981"/>
                        <TextBlock Text="Treated Calls" 
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>

                    <!-- Canceled Calls -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding CanceledCalls}" 
                                   Style="{StaticResource StatNumberStyle}" 
                                   Foreground="#F59E0B"/>
                        <TextBlock Text="Canceled Calls" 
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>

                    <!-- Expired Calls -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{Binding ExpiredCalls}" 
                                   Style="{StaticResource StatNumberStyle}" 
                                   Foreground="#EF4444"/>
                        <TextBlock Text="Expired Calls" 
                                   Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Charts Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Call Status Distribution Chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SimpleCardStyle}" Margin="0,0,4,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Call Status Distribution" 
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Image Grid.Row="1" 
                               Source="{Binding CallStatusChartImage}" 
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallStatusChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Loading indicator -->
                        <TextBlock Grid.Row="1" 
                                   Text="Loading chart..." 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallStatusChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Call Types Distribution Chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SimpleCardStyle}" Margin="4,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Call Types Distribution" 
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Image Grid.Row="1" 
                               Source="{Binding CallTypesChartImage}" 
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallTypesChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Loading indicator -->
                        <TextBlock Grid.Row="1" 
                                   Text="Loading chart..." 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CallTypesChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Activity Timeline Chart -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SimpleCardStyle}" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Activity Timeline" 
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <Image Grid.Row="1" 
                               Source="{Binding ActivityTimelineChartImage}" 
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivityTimelineChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Loading indicator -->
                        <TextBlock Grid.Row="1" 
                                   Text="Loading chart..." 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivityTimelineChartImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

