<Window x:Class="PL.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Login"
        Icon="pack://application:,,,/PL;component/Icons/Icon4.ico"
        Height="650"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" 
           ShadowDepth="1" 
           Direction="315" 
           Color="#DDDDDD" 
           Opacity="0.5" 
           BlurRadius="10"/>

        <!-- Style for TextBox with animation -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadowEffect" 
                                                 Color="#81D4FA" 
                                                 Direction="0" 
                                                 ShadowDepth="0" 
                                                 BlurRadius="0" 
                                                 Opacity="0"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#81D4FA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="15" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for PasswordBox with animation -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadowEffect" 
                                                 Color="#81D4FA" 
                                                 Direction="0" 
                                                 ShadowDepth="0" 
                                                 BlurRadius="0" 
                                                 Opacity="0"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#81D4FA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="15" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Button with animation -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadowEffect" 
                                                 Color="#81D4FA" 
                                                 Direction="0" 
                                                 ShadowDepth="0" 
                                                 BlurRadius="0" 
                                                 Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1F5FE"/>
                                <Setter Property="BorderBrush" Value="#81D4FA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="15" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="shadowEffect" 
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Animation for loading dots -->
        <Storyboard x:Key="LoadingAnimation">
            <DoubleAnimation Storyboard.TargetName="Dot1"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5"
                         AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Dot2"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5"
                         AutoReverse="True" RepeatBehavior="Forever"
                         BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="Dot3"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5"
                         AutoReverse="True" RepeatBehavior="Forever"
                         BeginTime="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>
    <Border Background="#F9F9F9" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" 
                           RenderingBias="Quality" ShadowDepth="2"
                           Color="#20000000"/>
        </Border.Effect>
        <Border Background="#F9F9F9" CornerRadius="12" Margin="14" Effect="{StaticResource DropShadowEffect}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <!-- Enhanced Icon with 3D effect and animation -->
                    <Border x:Name="iconBorder" 
                            Width="80" 
                            Height="80" 
                            Background="#F0F4F8" 
                            CornerRadius="40" 
                            BorderBrush="#E5E7EB" 
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect x:Name="iconShadowEffect" 
                                            BlurRadius="10" 
                                            Direction="315" 
                                            Color="#DDDDDD" 
                                            Opacity="0.5"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="iconShadowEffect" 
                                                       Storyboard.TargetProperty="BlurRadius"
                                                       To="20" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="iconShadowEffect" 
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="0.8" Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="iconShadowEffect"
                                                      Storyboard.TargetProperty="Color"
                                                      To="#81D4FA" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="iconShadowEffect" 
                                                       Storyboard.TargetProperty="BlurRadius"
                                                       To="10" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="iconShadowEffect" 
                                                       Storyboard.TargetProperty="Opacity"
                                                       To="0.5" Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="iconShadowEffect"
                                                      Storyboard.TargetProperty="Color"
                                                      To="#DDDDDD" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <!-- Enhanced icon with gradient fill -->
                        <Viewbox Width="46" Height="46">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6B7280" Offset="0"/>
                                            <GradientStop Color="#4B5563" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="2" 
                                                        Direction="315" 
                                                        Color="#333333" 
                                                        Opacity="0.3"
                                                        ShadowDepth="1"/>
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Title with simple hover animation -->
                    <TextBlock x:Name="titleText" 
                               Text="LOGIN" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#111827"
                               HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="titleScale" ScaleX="1" ScaleY="1" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="titleScale" 
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="titleScale" 
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="TextBlock.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="titleScale" 
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="titleScale" 
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock x:Name="subtitleText" 
                               Text="Volunteer app for soldiers" 
                               FontSize="13" 
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="subtitleScale" ScaleX="1" ScaleY="1" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="subtitleScale" 
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.05" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="subtitleScale" 
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.05" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="TextBlock.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="subtitleScale" 
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="subtitleScale" 
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>

                <!-- Login Form with gradient background and hover animation -->
                <Border x:Name="loginFormBorder" 
                        Grid.Row="1" 
                        CornerRadius="8" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="1" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F8FAFC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect x:Name="formShadowEffect" 
                                         Color="#AAAAAA" 
                                         Direction="0" 
                                         ShadowDepth="0" 
                                         BlurRadius="0" 
                                         Opacity="0"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="formShadowEffect" 
                                                   Storyboard.TargetProperty="BlurRadius"
                                                   To="15" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="formShadowEffect" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   To="0.3" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Border.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="formShadowEffect" 
                                                   Storyboard.TargetProperty="BlurRadius"
                                                   To="0" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="formShadowEffect" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   To="0" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <Label Content="Username" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtUsername" Padding="34,0,10,0"/>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                          Fill="#6B7280"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <Label Content="Password" Margin="0,14,0,5"/>
                        <Grid>
                            <PasswordBox x:Name="txtPassword" Padding="34,0,10,0"/>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                          Fill="#6B7280"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Loading Animation Panel -->
                <Border Grid.Row="2" 
                        Name="LoadingPanel" 
                        Background="#F0F4F8" 
                        CornerRadius="8" 
                        BorderBrush="#E5E7EB" 
                        BorderThickness="1" 
                        Padding="14"
                        Margin="0,0,0,20"
                        Visibility="Hidden">
                    <StackPanel>
                        <TextBlock Name="SuccessText" 
                                   FontSize="13" 
                                   TextAlignment="Center" 
                                   TextWrapping="Wrap" 
                                   Foreground="#374151"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Logging in..." 
                                   FontSize="13" 
                                   TextAlignment="Center"
                                   Foreground="#6B7280"/>
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,5,0,0">
                            <TextBlock Name="Dot1" 
                                       Text="•" 
                                       FontSize="26" 
                                       Opacity="0"
                                       Foreground="#374151"/>
                            <TextBlock Name="Dot2" 
                                       Text="•" 
                                       FontSize="26" 
                                       Opacity="0"
                                       Foreground="#374151"/>
                            <TextBlock Name="Dot3" 
                                       Text="•" 
                                       FontSize="26" 
                                       Opacity="0"
                                       Foreground="#374151"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Login Button with new icon -->
                <Button Grid.Row="4"
                        Width="110" 
                        Height="40" 
                        FontWeight="SemiBold"
                        FontSize="13"
                        Background="#F0F4F8"
                        HorizontalAlignment="Center"
                        Click="Login_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                            <Canvas Width="24" Height="24">
                                <!-- Modern Enter Arrow Icon -->
                                <Path Data="M19,7V11H5.83L9.41,7.41L8,6L2,12L8,18L9.41,16.58L5.83,13H21V7H19Z"
                                      Fill="#374151"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Login" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Border>
</Window>