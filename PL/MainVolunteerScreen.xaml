<Window x:Class="PL.MainVolunteerScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="My Volunteer Profile" Height="615" Width="860"
        SizeToContent="Height"
       
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <!-- Converters -->
        <local:IdToVisibilityConverter x:Key="IdToVisibilityConverterKey"/>
        <local:HalfValueConverter x:Key="HalfValueConverterKey"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ComboBoxToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                    Grid.ColumnSpan="2" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" />
                <Path x:Name="Arrow"
                  Grid.Column="1"     
                  Fill="#374151"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Arrow" Property="Fill" Value="#2563EB"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="6" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="6" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Grid>
                                <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Template="{StaticResource ComboBoxToggleButton}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="8,0,24,0"
                                                VerticalAlignment="Center"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       Placement="Bottom"
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Background="White" 
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border CornerRadius="6" 
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1">
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- עדכון סגנון פריטי ComboBox -->
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Border" Padding="8,6" CornerRadius="4" Margin="2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- מצב נבחר - אפור בהיר סטנדרטי -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <!-- מצב מעבר עכבר - צבעים עדינים יותר -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F0F7FF"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#E5E7EB"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Call Management Button Style -->
        <Style x:Key="CallManagementButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#81D4FA"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#81D4FA"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Call Management Item Style -->
        <Style x:Key="CallManagementItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="Transparent" 
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F7FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#81D4FA"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B3E5FC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4FC3F7"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Icon Styles -->
        <Style x:Key="ButtonIconStyle">
            <Setter Property="Control.Width" Value="14"/>
            <Setter Property="Control.Height" Value="14"/>
            <Setter Property="Control.Margin" Value="0,0,6,0"/>
            <Setter Property="Control.VerticalAlignment" Value="Center"/>
            <Setter Property="Shape.Fill" Value="#374151"/>
        </Style>

        <!-- Circular Progress Bar Style -->
        <Style x:Key="CircularProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Canvas Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                            </Canvas.RenderTransform>

                            <!-- 8 dots positioned in a circle -->
                            <Ellipse Fill="#2563EB" Width="5" Height="5" Canvas.Left="12.5" Canvas.Top="0"/>
                            <Ellipse Fill="#2563EB" Opacity="0.9" Width="5" Height="5" Canvas.Left="21" Canvas.Top="3"/>
                            <Ellipse Fill="#2563EB" Opacity="0.8" Width="5" Height="5" Canvas.Left="25" Canvas.Top="12.5"/>
                            <Ellipse Fill="#2563EB" Opacity="0.7" Width="5" Height="5" Canvas.Left="21" Canvas.Top="22"/>
                            <Ellipse Fill="#2563EB" Opacity="0.6" Width="5" Height="5" Canvas.Left="12.5" Canvas.Top="25"/>
                            <Ellipse Fill="#2563EB" Opacity="0.5" Width="5" Height="5" Canvas.Left="4" Canvas.Top="22"/>
                            <Ellipse Fill="#2563EB" Opacity="0.4" Width="5" Height="5" Canvas.Left="0" Canvas.Top="12.5"/>
                            <Ellipse Fill="#2563EB" Opacity="0.3" Width="5" Height="5" Canvas.Left="4" Canvas.Top="3"/>
                        </Canvas>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation 
                                        Storyboard.TargetName="SpinnerRotation" 
                                        Storyboard.TargetProperty="Angle" 
                                        From="0" To="360" Duration="0:0:1" 
                                        RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="-90" 
                              RenderingBias="Quality" ShadowDepth="2"
                              Color="#20000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Header with title -->
            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding WelcomeMessage}" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#111827"
                           VerticalAlignment="Center"/>

                <!-- Loading Spinner -->
                <ProgressBar Grid.Column="1" x:Name="LoadingIndicator"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             HorizontalAlignment="Right" 
                             VerticalAlignment="Top"
                             Width="30" Height="30"
                             IsIndeterminate="True"
                             Style="{StaticResource CircularProgressBarStyle}"
                             Margin="0,5,0,0"/>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto" MinHeight="0"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Info -->
                    <Border Grid.Row="0"
                            Background="White" 
                            CornerRadius="12"
                            Margin="0,8,16,8"
                            Padding="16">
                        <StackPanel Margin="0,0,0,-4">
                            <!-- Profile Picture -->
                            <Border Width="150" 
                                    Height="150" 
                                    CornerRadius="75" 
                                    BorderBrush="#E5E7EB" 
                                    BorderThickness="2"
                                    Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" 
                                                      ShadowDepth="1" 
                                                      Color="#20000000"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Profile picture with circular crop -->
                                    <Ellipse x:Name="ImageContainer">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileImageBrush" 
                                                        Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Border>

                            <!-- Profile Fields -->
                            <StackPanel Margin="0,8">
                                <Label Content="ID"/>
                                <TextBox Text="{Binding CurrentVolunteer.Id, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Margin="0,0,0,8" Height="32"/>

                                <Label Content="Full Name"/>
                                <TextBox Text="{Binding CurrentVolunteer.FullName, Mode=TwoWay, 
                                         NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                                         Margin="0,0,0,8" Height="30"/>

                                <Label Content="Phone Number"/>
                                <TextBox Text="{Binding CurrentVolunteer.PhoneNumber, Mode=TwoWay, 
                                         NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                                         Margin="0,0,0,8" Height="30"/>

                                <Label Content="Email"/>
                                <TextBox Text="{Binding CurrentVolunteer.Email, Mode=TwoWay, 
                                         NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                                         Margin="0,0,0,8" Height="28"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Address Section (Moved to bottom left) -->
                    <Border Background="White" 
                            CornerRadius="12"
                            Margin="0,398,16,-4"
                            Padding="16" Grid.RowSpan="2">
                        <StackPanel>
                            <Label Content="Current Address" Height="26"/>
                            <TextBox Text="{Binding CurrentVolunteer.CurrentAddress, Mode=TwoWay}" Height="28"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Right Column -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="12"
                        Margin="0,8,0,0"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="My Details" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,16"/>

                        <Label Content="Role"/>
                        <TextBox Text="{Binding CurrentVolunteer.Role}" IsReadOnly="True"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Max Distance"/>
                                <TextBox Text="{Binding CurrentVolunteer.MaxDistance, Mode=TwoWay, 
                                         StringFormat='{}{0:N2} km'}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="Distance Type"/>
                                <ComboBox ItemsSource="{Binding DistanceTypesCollection}" 
                                         SelectedValue="{Binding CurrentVolunteer.DistanceType, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Statistics Fields -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="8" Background="#F0F0F0">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Total Handled Calls" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentVolunteer.TotalHandledCalls}" 
                                               FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="4,0" CornerRadius="8" Background="#F0F0F0">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Total Self Cancelled Calls" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentVolunteer.TotalCancelledCalls}" 
                                               FontSize="20" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Margin="4,0,0,0" CornerRadius="8" Background="#F0F0F0">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Total Expired Calls" FontWeight="SemiBold" Margin="0,0,0,4" FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentVolunteer.TotalExpiredCalls}" 
                                               FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Margin="0,8">
                            <!-- Active Status Section -->
                            <DockPanel VerticalAlignment="Center">
                                <Label Content="Active Status" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding CurrentVolunteer.IsActive}"
                                          IsEnabled="False"
                                          VerticalAlignment="Center"
                                          Margin="8,0"/>
                            </DockPanel>

                            <!-- Call Management Section -->
                            <Border Padding="12" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Height="149">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#40000000"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="BorderBrush" Value="#81D4FA"/>
                                                <Setter Property="BorderThickness" Value="2.5"/>
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Call Management" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="#333333" Height="18"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- First row of buttons -->
                                        <Button Click="OnOpenActiveCallClick"
                                                Grid.Column="0"
                                                Margin="0,0,4,8"
                                                Style="{StaticResource CallManagementButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Check Active Call" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Click="OnSelectCallClick"
                                                Grid.Column="1"
                                                Margin="4,0,0,8"
                                                Style="{StaticResource CallManagementButtonStyle}"
                                                IsEnabled="{Binding CurrentVolunteer.ActiveCall, ConverterParameter=inverse, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Select Open Call" VerticalAlignment="Center" Width="95" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Second row of buttons -->
                                        <Button Click="OnViewCallHistoryClick"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource CallManagementButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="View Call History" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Click="UpdateButton_Click"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource CallManagementButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Update Information" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

