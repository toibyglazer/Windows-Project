<Window x:Class="PL.Volunteer.VolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        Title="Volunteer Details" Height="700" Width="1000" 
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="Transparent"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <local:AddUpdateToReadOnlyConverter x:Key="AddUpdateToReadOnlyConverterKey" />
        <local:IdToVisibilityConverter x:Key="IdToVisibilityConverterKey"/>
        <local:HalfValueConverter x:Key="HalfValueConverterKey"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ComboBoxToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                    Grid.ColumnSpan="2" 
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0" />
                <Path x:Name="Arrow"
                  Grid.Column="1"     
                  Fill="#374151"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Arrow" Property="Fill" Value="#2563EB"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="#FFFFFF" 
                                CornerRadius="8" 
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <Grid>
                                <ToggleButton IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            Template="{StaticResource ComboBoxToggleButton}"/>
                                <ContentPresenter x:Name="ContentSite"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="10,0,30,0"
                                                VerticalAlignment="Center"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" 
                                       Placement="Bottom"
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Background="White" 
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border CornerRadius="8" 
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1">
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Button -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" 
                           RenderingBias="Quality" ShadowDepth="2"
                           Color="#20000000"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="182*" />
                <RowDefinition Height="405*"/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Header with close button -->
            <Grid Grid.ColumnSpan="2">
                <TextBlock Text="Volunteer Details" 
                         FontSize="28" 
                         FontWeight="Bold" 
                         Foreground="#111827"/>
            </Grid>

            <!-- Left Column -->
            <Border Grid.Row="1" 
        Grid.Column="0" 
        Background="White" 
        CornerRadius="15"
        Margin="0,2,20,-5"
        Padding="20" Grid.RowSpan="3">
                <StackPanel>
                    <!-- Profile Picture -->
                    <Border Width="180" 
        Height="180" 
        CornerRadius="90" 
        BorderBrush="#E5E7EB" 
        BorderThickness="2"
        Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                          ShadowDepth="1" 
                          Color="#20000000"/>
                        </Border.Effect>
                        <Grid>
                            <!-- תמונת הפרופיל עם חיתוך עגול -->
                            <Ellipse x:Name="ImageContainer">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfileImageBrush" 
                            Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- כפתור "+" -->
                            <Button Content="+" 
                Width="40" Height="40"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,10,10"
                IsHitTestVisible="False"/>
                        </Grid>
                    </Border>






                    <!-- Profile Fields -->
                    <StackPanel Margin="0,10">
                        <Label Content="ID"/>
                        <TextBox Text="{Binding CurrentVolunteer.Id, Mode=TwoWay}"
                     IsReadOnly="{Binding ButtonText, Converter={StaticResource AddUpdateToReadOnlyConverterKey}}"
                     Margin="0,0,0,10" Height="38"/>

                        <Label Content="Full Name"/>
                        <TextBox Text="{Binding CurrentVolunteer.FullName, Mode=TwoWay, 
                     NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                     Margin="0,0,0,10" Height="35"/>

                        <Label Content="Phone Number"/>
                        <TextBox Text="{Binding CurrentVolunteer.PhoneNumber, Mode=TwoWay, 
                     NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                     Margin="0,0,0,10" Height="36"/>

                        <Label Content="Email"/>
                        <TextBox Text="{Binding CurrentVolunteer.Email, Mode=TwoWay, 
                     NotifyOnValidationError=true, ValidatesOnExceptions=true}"
                     Margin="0,0,0,10" Height="33"/>
                    </StackPanel>
                </StackPanel>
            </Border>



            <!-- Right Column -->
            <Border 
        Background="White" 
        CornerRadius="15"
        Margin="313,2,0,0"
        Padding="20" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2">
                <StackPanel>
                    <TextBlock Text="Additional Details" 
                 FontSize="20" 
                 FontWeight="Bold" 
                 Margin="0,0,0,20"/>


                    <Label Content="Current Address"/>
                    <TextBox Text="{Binding CurrentVolunteer.CurrentAddress, Mode=TwoWay}"/>

                    <Label Content="Role"/>
                    <ComboBox ItemsSource="{Binding volunteerRoleCollection}" 
                 SelectedItem="{Binding CurrentVolunteer.Role, Mode=TwoWay}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Max Distance"/>
                            <TextBox Text="{Binding CurrentVolunteer.MaxDistance, Mode=TwoWay, 
                         StringFormat='{}{0:N2} km'}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Label Content="Distance Type"/>
                            <ComboBox ItemsSource="{Binding DistanceTypesCollection}" 
                         SelectedValue="{Binding CurrentVolunteer.DistanceType, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- New Fields -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,5,0" CornerRadius="10" Background="#F0F0F0">
                            <StackPanel Margin="10">
                                <TextBlock Text="Total Handled Calls" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CurrentVolunteer.TotalHandledCalls}" 
                       FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0" CornerRadius="10" Background="#F0F0F0">
                            <StackPanel Margin="10">
                                <TextBlock Text="Total Cancelled Calls" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CurrentVolunteer.TotalCancelledCalls}" 
                       FontSize="24" FontWeight="Bold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="5,0,0,0" CornerRadius="10" Background="#F0F0F0">
                            <StackPanel Margin="10">
                                <TextBlock Text="Total Expired Calls" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CurrentVolunteer.TotalExpiredCalls}" 
                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Margin="0,10">
                        <!-- Active Status Section -->
                        <DockPanel VerticalAlignment="Center">
                            <Label Content="Active Status" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding CurrentVolunteer.IsActive, Mode=TwoWay}"
                  VerticalAlignment="Center"
                  Margin="10,0"/>
                        </DockPanel>

                        <!-- Buttons in the next row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <!-- Delete Volunteer Button with Icon -->
                            <Button x:Name="DeleteVolunteerButton"
Click="DeleteVolunteerButton_Click"
Width="40"
Height="40"
Background="Transparent"
BorderThickness="0"
ToolTip="Delete Volunteer"
Margin="10,0,0,0">
                                <TextBlock Text="🗑" 
       FontSize="20" 
       VerticalAlignment="Center"
       HorizontalAlignment="Center"
       Foreground="Black"/>
                            </Button>
                            <Button Content="Active Reading Check"
                Click="OnOpenActiveCallClick"
                Width="150"
                Margin="0,0,10,0"
                Visibility="{Binding CurrentVolunteer.Id, Converter={StaticResource IdToVisibilityConverterKey}}"/>

                            <Button Content="{Binding ButtonText}"
                Click="AddOrUpdateButton_Click"
                Width="150"
                Margin="10,0,0,0"/>


                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>


        </Grid>
    </Border>
</Window>